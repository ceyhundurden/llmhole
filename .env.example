# AISEC Lab configuration. Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
#
# IMPORTANT: Live Mode API keys (Anthropic / OpenAI) are entered in the browser
# UI, held in memory for that session only, and are NEVER stored here, on disk,
# or in logs. Do NOT put any API key in this file or commit one to the repo.

# Host port to publish the lab on.
AISEC_PORT=8000

# HMAC key used to sign challenge flags. Change this if you host a CTF so flags
# are unique to your instance.
AISEC_FLAG_SECRET=change-me-for-ctf-hosting

# Set to 0 to hide the built-in reference solutions.
AISEC_ALLOW_SOLUTIONS=1

# Live Mode: where the browser-side lab reaches your Ollama server.
# - Running the lab in Docker with Ollama on your host: keep the compose default
#   (http://host.docker.internal:11434).
# - Running the lab with bare `uvicorn`: use http://localhost:11434.
# AISEC_OLLAMA_ENDPOINT=http://host.docker.internal:11434

# --- Security / hardening (see SECURITY.md) ---
# Interface the container publishes on. Default 127.0.0.1 (loopback only).
# AISEC_BIND=127.0.0.1
# CTF mode: fail fast on the default flag secret and hide reference solutions.
# AISEC_CTF_MODE=0
# SSRF allow-list for Live Mode outbound calls (comma-separated hosts).
# AISEC_ALLOWED_LLM_HOSTS=localhost,127.0.0.1,::1,host.docker.internal
# AISEC_ALLOWED_LLM_PORTS=11434
# Session memory bounds.
# AISEC_MAX_SESSIONS=5000
# AISEC_SESSION_TTL=21600
# AISEC_MAX_BUCKET_ITEMS=200
